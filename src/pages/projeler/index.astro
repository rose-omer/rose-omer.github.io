---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';
import { TAGS } from '../../content.config';

const projects = await getProjects();
const counts = Object.fromEntries(TAGS.map((t) => [t, projects.filter((p) => p.data.tags.includes(t)).length]));
---

<Base title="Projeler" description="Ömer Faruk Köse'nin bilgisayarlı görü, makine öğrenmesi ve web projeleri; etikete göre filtrelenebilir.">
  <div class="wrap page">
    <header class="page-head">
      <h1>Projeler</h1>
      <p class="lede">
        Herkese açık depolarımdaki projeler. Her biri için problem, yaklaşım, sonuç ve kod bağlantısı var.
      </p>
    </header>

    <div class="filter no-print" data-filter hidden>
      <p id="filtre-baslik" class="filter-label">Etikete göre filtrele</p>
      <ul class="filter-list" role="list" aria-labelledby="filtre-baslik">
        <li>
          <button type="button" class="fbtn" data-tag="" aria-pressed="true">
            Tümü <span class="count">{projects.length}</span>
          </button>
        </li>
        {
          TAGS.map((t) => (
            <li>
              <button type="button" class="fbtn" data-tag={t} aria-pressed="false">
                {t} <span class="count">{counts[t]}</span>
              </button>
            </li>
          ))
        }
      </ul>
      <p class="status" role="status" aria-live="polite" data-status></p>
    </div>

    <ul class="grid" data-list>
      {
        projects.map((p) => (
          <li data-item data-tags={p.data.tags.join('|')}>
            <ProjectCard project={p} headingLevel={2} />
          </li>
        ))
      }
    </ul>

    <div class="empty" data-empty hidden>
      <h2 class="empty-title">Bu etikette proje yok</h2>
      <p>Bu alandaki çalışmalarım henüz herkese açık bir depoda değil.</p>
      <button type="button" class="btn btn--line" data-clear>Filtreyi temizle</button>
    </div>
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-filter]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.fbtn')];

  function apply(tag: string, announce = true) {
    let shown = 0;
    for (const item of items) {
      const match = !tag || (item.dataset.tags ?? '').split('|').includes(tag);
      item.hidden = !match;
      if (match) shown++;
    }
    for (const b of buttons) b.setAttribute('aria-pressed', String((b.dataset.tag ?? '') === tag));
    if (empty) empty.hidden = shown > 0;
    if (status && announce) status.textContent = tag ? `${tag}: ${shown} proje gösteriliyor.` : `Bütün projeler gösteriliyor (${shown}).`;

    // Filtre adreste kalır; bağlantı paylaşılınca aynı görünüm açılır.
    const url = new URL(location.href);
    if (tag) url.searchParams.set('etiket', tag);
    else url.searchParams.delete('etiket');
    history.replaceState(null, '', url);
  }

  if (root) {
    root.hidden = false;
    for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.tag ?? ''));
    document.querySelector('[data-clear]')?.addEventListener('click', () => {
      apply('');
      buttons[0]?.focus();
    });
    const initial = new URL(location.href).searchParams.get('etiket') ?? '';
    if (buttons.some((b) => b.dataset.tag === initial)) apply(initial, false);
  }
</script>

<style>
  .page {
    padding-block: var(--space-8);
  }

  .page-head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .filter {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .filter[hidden] {
    display: none;
  }

  .filter-label {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .filter-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .fbtn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    font: 500 var(--step--1) / 1 var(--font-mono);
    cursor: pointer;
    transition: background-color 120ms ease, border-color 120ms ease;
  }

  .fbtn:hover {
    border-color: var(--muted);
  }

  .fbtn[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .count {
    color: var(--muted);
  }

  .fbtn[aria-pressed='true'] .count {
    color: inherit;
    opacity: 0.75;
  }

  .status {
    min-height: 1.5em;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8) var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-7) var(--space-6);
    }
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--muted);
  }

  .empty[hidden] {
    display: none;
  }

  .empty-title {
    font-size: var(--step-1);
  }
</style>
