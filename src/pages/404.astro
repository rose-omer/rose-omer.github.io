---
import Base from '../layouts/Base.astro';
---

<Base title="Sayfa bulunamadı" description="Aradığın adreste bir sayfa yok." noindex>
  <div class="wrap page">
    <div class="miss" aria-hidden="true">
      <span class="miss-tag">sonuç yok 0,00</span>
    </div>
    <h1>Bu adreste sayfa yok</h1>
    <p class="lede">Bağlantı eski olabilir ya da adreste yazım hatası olabilir. Projelerin tamamı tek sayfada listeli.</p>
    <div class="actions">
      <a class="btn" href="/projeler/">Projelere git</a>
      <a class="btn btn--line" href="/">Ana sayfa</a>
    </div>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding-block: var(--space-9);
  }

  /* Boş tespit kutusu: aranan şey karede yok. */
  .miss {
    position: relative;
    width: min(16rem, 70vw);
    aspect-ratio: 4 / 3;
    border: 1.5px dashed var(--box);
    margin-top: var(--space-5);
  }

  .miss-tag {
    position: absolute;
    left: -1.5px;
    bottom: 100%;
    padding: 3px 8px 2px;
    background: var(--accent);
    color: var(--accent-ink);
    font: 600 var(--step--1) / 1.2 var(--font-mono);
  }

  h1 {
    font-size: var(--step-3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
