---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeatured, getProjects } from '../lib/projects';
import { site, focusAreas } from '../data/site';

const featured = await getFeatured(3);
const total = (await getProjects()).length;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.roleEn,
  worksFor: { '@type': 'Organization', name: 'İyex Teknoloji' },
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  sameAs: [site.links.github, site.links.linkedin, site.links.medium],
  knowsAbout: ['Computer Vision', 'YOLO', 'OCR', 'Vision Language Models'],
};
---

<Base type="profile" jsonLd={person}>
  <section class="hero wrap" aria-labelledby="ad">
    <div class="hero-main">
      <h1 id="ad" class="detect">
        <span class="detect-tag" aria-hidden="true">mühendis 0,98</span>
        {site.name}
      </h1>
      <p class="role">{site.role}</p>
      <p class="intro">{site.intro}</p>
      <ul class="chip-list focus-chips" aria-label="Odak alanları">
        <li class="chip">YOLO</li>
        <li class="chip">OCR</li>
        <li class="chip">VLM</li>
      </ul>
      <div class="actions">
        <a class="btn" href="/projeler/">Projeleri gör</a>
        <a class="btn btn--line" href="/cv/">CV</a>
      </div>
    </div>
    <dl class="readout" aria-label="Kısa bilgi">
      <div><dt>şu an</dt><dd>İyex Teknoloji</dd></div>
      <div><dt>konum</dt><dd>{site.location}</dd></div>
      <div><dt>açık proje</dt><dd>{total}</dd></div>
      <div><dt>kod</dt><dd><a href={site.links.github}>github.com/rose-omer</a></dd></div>
    </dl>
  </section>

  <section class="section" aria-labelledby="one-cikan">
    <div class="wrap">
      <div class="section-head">
        <h2 id="one-cikan">Öne çıkan projeler</h2>
        <a class="all-link" href="/projeler/">Bütün projeler ({total})</a>
      </div>
      <ul class="grid">
        {
          featured.map((p) => (
            <li>
              <ProjectCard project={p} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="alanlar">
    <div class="wrap">
      <div class="section-head">
        <h2 id="alanlar">Çalıştığım alanlar</h2>
      </div>
      <ul class="areas">
        {
          focusAreas.map((a) => (
            <li class="area">
              <p class="area-term" aria-hidden="true">{a.term}</p>
              <div class="area-body">
                <h3>
                  {a.name} <span class="visually-hidden">({a.term})</span>
                </h3>
                <p>{a.text}</p>
              </div>
              <p class="area-link">
                {a.project ? (
                  <a href={`/projeler/${a.project.slug}/`}>{a.project.label} vakası</a>
                ) : (
                  <span class="muted">Açık örnek yok</span>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="iletisim">
    <div class="wrap contact">
      <h2 id="iletisim">İletişim</h2>
      <p class="lede">İş, staj ya da ortak proje için e-posta yaz.</p>
      <p><a class="mail" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-8) var(--space-8);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 19rem;
      align-items: end;
      padding-block: var(--space-9) var(--space-8);
    }
  }

  /* Ad, nesne tespiti kutusunun içinde: sitenin tek "imza" öğesi. */
  .detect {
    position: relative;
    display: inline-block;
    max-width: 100%;
    margin-top: var(--space-5);
    padding: 0.12em 0.22em 0.16em;
    line-height: 0.98;
  }

  /* Kutu sol üstten sağ alta çizilir; metin hiç kesilmez. */
  .detect::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--box);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .detect::before {
      animation: draw 620ms var(--ease-out) both;
    }

    .detect-tag {
      animation: tag 240ms 460ms var(--ease-out) both;
    }
  }

  .detect-tag {
    position: absolute;
    left: 0;
    bottom: 100%;
    padding: 3px 8px 2px;
    background: var(--accent);
    color: var(--accent-ink);
    font: 600 var(--step--1) / 1.2 var(--font-mono);
    letter-spacing: 0;
    white-space: nowrap;
  }

  @keyframes draw {
    from {
      clip-path: inset(0 100% 100% 0);
    }
    to {
      clip-path: inset(0);
    }
  }

  @keyframes tag {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .role {
    margin-top: var(--space-5);
    font: 600 var(--step-1) / 1.3 var(--font-display);
    font-stretch: 92%;
  }

  .intro {
    margin-top: var(--space-3);
    max-width: 52ch;
    color: var(--muted);
  }

  .focus-chips {
    margin-top: var(--space-5);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .readout {
    margin: 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--line);
    font: 400 var(--step--1) / 1.5 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .readout div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .readout dt {
    color: var(--muted);
  }

  .readout dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .all-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7) var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .area {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 48rem) {
    .area {
      grid-template-columns: 9rem minmax(0, 1fr) 13rem;
      align-items: baseline;
    }
  }

  .area-term {
    font: 700 var(--step-3) / 1 var(--font-display);
    font-stretch: 70%;
    color: var(--box);
  }

  .area-body {
    display: grid;
    gap: var(--space-1);
  }

  .area-body p {
    color: var(--muted);
    max-width: 60ch;
  }

  .area-link a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  .muted {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .contact {
    display: grid;
    gap: var(--space-4);
  }

  .mail {
    font: 650 var(--step-2) / 1.2 var(--font-display);
    font-stretch: 88%;
    overflow-wrap: anywhere;
  }
</style>
