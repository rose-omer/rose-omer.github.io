---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CoverArt from './CoverArt.astro';
import type { MOTIFS } from '../content.config';

interface Props {
  cover?: ImageMetadata;
  /** Kart içinde başlık zaten okunur; kapak bu durumda süslemedir. */
  alt?: string;
  motif: (typeof MOTIFS)[number];
  eager?: boolean;
  sizes?: string;
}

const { cover, alt = '', motif, eager = false, sizes = '(min-width: 72rem) 22rem, (min-width: 40rem) 45vw, 92vw' } = Astro.props;

// Yükleme sırasında görünen bulanık yer tutucu: 24 px genişlikte küçük kopya.
const lqip = cover ? await getImage({ src: cover, width: 24, format: 'webp', quality: 40 }) : null;
---

<div class="frame" style={lqip ? `background-image:url(${lqip.src})` : undefined}>
  {
    cover ? (
      <Picture
        src={cover}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <CoverArt motif={motif} />
    )
  }
</div>

<style>
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--sunk);
    background-size: cover;
    background-position: top left;
    border-radius: var(--radius);
  }

  .frame :global(picture),
  .frame :global(img) {
    width: 100%;
    height: 100%;
  }

  .frame :global(img) {
    object-fit: cover;
    object-position: top left;
  }
</style>
