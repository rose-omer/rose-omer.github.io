---
/**
 * Önce/sonra karşılaştırması. Üstteki görsel clip-path ile kesilir; oran
 * <input type="range"> ile değişir (ok tuşları, Home/End, sürükleme).
 * JS yoksa iki görsel yan yana görünür.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeLabel: string;
  afterLabel: string;
  beforeAlt: string;
  afterAlt: string;
  caption: string;
}

const { before, after, beforeLabel, afterLabel, beforeAlt, afterAlt, caption } = Astro.props;
---

<figure class="compare" data-compare style="--pos: 50%">
  <div class="stage">
    <div class="layer layer-after">
      <Image src={after} alt={afterAlt} widths={[640, 1000]} sizes="(min-width: 60rem) 44rem, 92vw" loading="lazy" />
      <span class="label label-after" aria-hidden="true">{afterLabel}</span>
    </div>
    <div class="layer layer-before">
      <Image src={before} alt={beforeAlt} widths={[640, 1000]} sizes="(min-width: 60rem) 44rem, 92vw" loading="lazy" />
      <span class="label label-before" aria-hidden="true">{beforeLabel}</span>
    </div>
    <div class="handle" aria-hidden="true"></div>
    <input
      class="range"
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      aria-label="Karşılaştırma oranı"
      aria-valuetext={`%50 ${beforeLabel}`}
      data-before={beforeLabel}
    />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((figure) => {
    const input = figure.querySelector<HTMLInputElement>('input[type="range"]');
    if (!input) return;
    const update = () => {
      figure.style.setProperty('--pos', `${input.value}%`);
      input.setAttribute('aria-valuetext', `%${input.value} ${input.dataset.before ?? ''}`.trim());
    };
    input.addEventListener('input', update);
    update();
    figure.classList.add('is-ready');
  });
</script>

<style>
  .compare {
    margin: 0;
  }

  /* JS yok: iki görsel yan yana, etiketleri görünür. */
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .layer {
    position: relative;
  }

  .layer :global(img) {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .layer-after {
    order: 2;
  }

  .handle,
  .range {
    display: none;
  }

  .label {
    position: absolute;
    top: var(--space-2);
    padding: 2px var(--space-2);
    background: var(--ink);
    color: var(--paper);
    font: 600 var(--step--1) / 1.4 var(--font-mono);
    border-radius: var(--radius);
  }

  .label-before {
    left: var(--space-2);
  }

  .label-after {
    right: var(--space-2);
  }

  /* JS var: üst üste, kesmeli görünüm. */
  .compare:global(.is-ready) .stage {
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    touch-action: pan-y;
  }

  .compare:global(.is-ready) .layer :global(img) {
    border: 0;
    border-radius: 0;
  }

  .compare:global(.is-ready) .layer-before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .compare:global(.is-ready) .handle {
    display: block;
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--box);
    pointer-events: none;
  }

  .compare:global(.is-ready) .handle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 28px;
    height: 28px;
    translate: -50% -50%;
    border: 2px solid var(--box);
    border-radius: 50%;
    background: var(--surface);
  }

  .compare:global(.is-ready) .range {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .compare:global(.is-ready) .stage:has(.range:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  figcaption {
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--step--1);
    max-width: var(--measure);
  }
</style>
