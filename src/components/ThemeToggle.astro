---
// Açık/koyu tema düğmesi. Seçim localStorage'da ('tema') saklanır,
// <html data-theme> ile uygulanır. İlk boyamadaki uygulama Base.astro'da.
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Koyu temaya geç">
  <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
  </svg>
  <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
  </svg>
</button>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const current = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? (media.matches ? 'dark' : 'light');

  function sync(button: HTMLButtonElement) {
    const dark = current() === 'dark';
    button.setAttribute('aria-label', dark ? 'Açık temaya geç' : 'Koyu temaya geç');
    button.dataset.state = dark ? 'dark' : 'light';
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    sync(button);
    media.addEventListener('change', () => sync(button));
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('tema', next);
      } catch {
        /* Gizli pencerede depolama kapalı olabilir; tema yine bu sayfada değişir. */
      }
      sync(button);
    });
  });
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: var(--space-1);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--muted);
  }

  .icon {
    grid-area: 1 / 1;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Düğme, geçilecek temanın simgesini gösterir. */
  .icon-sun,
  .theme-toggle[data-state='dark'] .icon-moon {
    display: none;
  }

  .theme-toggle[data-state='dark'] .icon-sun {
    display: block;
  }
</style>
